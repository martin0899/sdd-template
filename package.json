{
  "name": "spectralis",
  "version": "1.2.0",
  "description": "SDD template installer CLI: init, update, status, config and doctor for Spec-Driven Development projects",
  "bin": {
    "spectralis": "dist/bin/spectralis.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    ".agents/",
    ".opencode/",
    "docs/",
    "docs-variants/",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/**/*.test.js'"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
